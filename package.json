{
  "name": "arabic-exams",
  "productName": "برنامج الاختبارات",
  "version": "0.1.0",
  "description": "برنامج اختبارات تفاعلي عربي يعمل دون إنترنت",
  "private": true,
  "main": "dist/main/main/main.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "start": "electron .",
    "dev": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.preload.json && tsc -p tsconfig.renderer.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist:win": "npm run build && electron-builder --win",
    "build:preload": "esbuild src/preload/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/main/preload/preload.js"
  },
  "dependencies": {
    "sql.js": "1.13.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.39.0",
    "@fontsource/tajawal": "5.3.0",
    "@types/node": "22.18.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/sql.js": "1.4.9",
    "@vitejs/plugin-react": "5.1.0",
    "electron": "43.7.6",
    "electron-builder": "26.0.12",
    "esbuild": "0.25.12",
    "eslint": "9.39.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.0",
    "vite": "7.1.12",
    "vitest": "3.2.4"
  },
  "build": {
    "appId": "local.arabic-exams",
    "productName": "ArabicExams",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/sql.js/dist/sql-wasm.wasm"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "ArabicExams-${version}-portable.exe"
    }
  }
}
